+void RTW88IEEE80211::evictSSIDElsewhere(const uint8_t *ssid, uint32_t ssidLen, uint16_t channel)
+{
+    uint32_t evicted = 0;
+    IOLockLock(_bssLock);
+    for (RTW88BSS **link = &_bssList; *link; ) {
+        RTW88BSS *b = *link;
+        const bool current = _associatedVisible && memcmp(b->bssid, _targetBSS.bssid, 6) == 0;
+        if (!current && b->channel != channel && b->ssid_len == ssidLen &&
+            memcmp(b->ssid, ssid, ssidLen) == 0) {
+            *link = b->next;
+            IOFree(b, sizeof(*b));
+            if (_bssCount) _bssCount--;
+            ++evicted;
+            continue;
+        }
+        link = &b->next;
+    }
+    IOLockUnlock(_bssLock);
+    if (evicted) {
+        _staleSSIDEvictions += evicted;
+        IOLog("rtw88: directed scan ch=%u evicted %u stale record(s) of the same SSID\n",
+              (unsigned)channel, evicted);
+    }
+}
