+/* macOS port: the dynamic watchdog is off, so nothing else reads or resets
+ * the PHY receive counters.  Read them (ok in the low 16 bits, CRC errors in
+ * the high 16) and optionally reset them, to see whether frames that never
+ * reach the driver were heard by the PHY but failed to decode. */
+void rtw88_macos_rx_crc(struct rtw_dev *rtwdev, bool reset, u32 *out)
+{
+	if (out)
+		memset(out, 0, 6 * sizeof(*out));
+	if (!rtwdev || !rtwdev->chip || rtwdev->chip->id != RTW_CHIP_TYPE_8822C)
+		return;
+	if (out) {
+		out[0] = rtw_read32(rtwdev, 0x2c04);	/* CCK  */
+		out[1] = rtw_read32(rtwdev, 0x2c14);	/* OFDM */
+		out[2] = rtw_read32(rtwdev, 0x2c10);	/* HT   */
+		out[3] = rtw_read32(rtwdev, 0x2c0c);	/* VHT  */
+		out[4] = rtw_read32(rtwdev, REG_OFDM_FACNT3) & 0xffff;	/* VHT-SIG-A CRC8 */
+		out[5] = rtw_read32(rtwdev, REG_OFDM_FACNT4) >> 16;	/* VHT MCS fail  */
+	}
+	if (reset) {
+		rtw_write32_mask(rtwdev, REG_CCANRX, BIT_CCK_FA_RST, 0);
+		rtw_write32_mask(rtwdev, REG_CCANRX, BIT_CCK_FA_RST, 2);
+		rtw_write32_mask(rtwdev, REG_CCANRX, BIT_OFDM_FA_RST, 0);
+		rtw_write32_mask(rtwdev, REG_CCANRX, BIT_OFDM_FA_RST, 2);
+		rtw_write32_clr(rtwdev, REG_RX_BREAK, BIT_COM_RX_GCK_EN);
+		rtw_write32_set(rtwdev, REG_CNT_CTRL, BIT_ALL_CNT_RST);
+		rtw_write32_clr(rtwdev, REG_CNT_CTRL, BIT_ALL_CNT_RST);
+		rtw_write32_set(rtwdev, REG_RX_BREAK, BIT_COM_RX_GCK_EN);
+	}
+}
