+// Between association and the PTK, report what the radio hears from the AP:
+// a handshake that never starts is otherwise indistinguishable from one whose
+// first message was received and dropped.
+void RTW88IEEE80211::noteHandshakeRx(const struct sk_buff *skb, const struct ieee80211_rx_status *rxs)
+{
+    const struct ieee80211_hdr *hdr = (const struct ieee80211_hdr *)skb->data;
+    const uint16_t fc = le16_to_cpu(hdr->frame_control);
+    ++_hsRx.all;
+    if (memcmp(hdr->addr2, _targetBSS.bssid, 6) != 0) return;
+    const bool data = ieee80211_is_data(hdr->frame_control);
+    if (data) ++_hsRx.dataFromAP; else ++_hsRx.otherFromAP;
+    memcpy(_hsRx.lastAddr1, hdr->addr1, 6);
+    const bool unicast = memcmp(hdr->addr1, _macAddr, 6) == 0;
+    if (unicast) ++_hsRx.unicast;
+    if (data && (fc & IEEE80211_FCTL_ORDER)) ++_hsRx.htc;
+    /* The first frames after association are mostly beacons and multicast;
+     * always log frames addressed to us so the EAPOL M1 is visible. */
+    if (_hsRx.logged < 8 || (unicast && _hsRx.unicastLogged < 8)) {
+        if (_hsRx.logged < 8) ++_hsRx.logged; else ++_hsRx.unicastLogged;
+        IOLog("rtw88: handshake rx from AP fc=0x%04x a1=%02x:%02x:%02x:%02x:%02x:%02x len=%u rate=%u enc=%u bw=%u band=%u\n",
+              fc, hdr->addr1[0], hdr->addr1[1], hdr->addr1[2], hdr->addr1[3], hdr->addr1[4], hdr->addr1[5],
+              skb->len, (unsigned)rxs->rate_idx, (unsigned)rxs->encoding, (unsigned)rxs->bw, (unsigned)rxs->band);
+    }
+}
