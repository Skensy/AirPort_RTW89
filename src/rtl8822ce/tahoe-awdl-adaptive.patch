+/* Legacy-OFDM unicast ladder for direct AWDL flows.  A tier is only sustained
+ * by fresh firmware ACK reports from the same destination, on the same channel,
+ * at that rate.  One active flow keeps the learning state bounded; switching
+ * peer or channel restarts it. */
+inline bool adaptiveRateDevice(uint16_t vendor, uint16_t device) {
+    return vendor == 0x10ec && (device == 0xc822 || device == 0xc82f);
+}
+
+struct RateTier { uint8_t mbps; int8_t minRssi; };
+constexpr RateTier rateLadder[] = {
+    {6, -128}, {24, -65}, {36, -60}, {48, -56}, {54, -52},
+};
+constexpr unsigned rateTierCount = sizeof(rateLadder) / sizeof(rateLadder[0]);
+constexpr uint16_t ratePromotionAcks = 16;
+constexpr uint64_t rateEvidenceAgeUS = 750000;
+
+inline bool freshRateReport(uint64_t sent, uint64_t now) {
+    return sent && now >= sent && now - sent <= rateEvidenceAgeUS;
+}
+
+inline unsigned rateIndex(uint8_t mbps) {
+    for (unsigned i = 0; i < rateTierCount; ++i)
+        if (rateLadder[i].mbps == mbps) return i;
+    return rateTierCount;
+}
+
+struct RateFlow {
+    uint8_t dst[6] = {};
+    uint16_t channel = 0;
+    uint32_t generation = 0;
+    uint64_t lastAckUS = 0;
+    uint16_t acked = 0;
+    uint8_t tier = 0;
+    bool valid = false;
+
+    void resetTier() {
+        tier = 0; acked = 0; lastAckUS = 0; ++generation;
+    }
+    void invalidate() { resetTier(); valid = false; }
+    void start(const uint8_t *mac, uint16_t ch) {
+        if (mac) memcpy(dst, mac, sizeof(dst));
+        else memset(dst, 0, sizeof(dst));
+        channel = ch;
+        resetTier();
+        valid = true;
+    }
+    uint8_t currentMbps() const {
+        return rateLadder[tier < rateTierCount ? tier : 0].mbps;
+    }
+    unsigned allowedTier(int8_t rssi) const {
+        unsigned best = 0;
+        for (unsigned i = 1; i < rateTierCount; ++i)
+            if (rssi >= rateLadder[i].minRssi) best = i;
+        return best;
+    }
+    uint8_t select(const uint8_t *mac, uint16_t ch, int8_t rssi, bool fresh,
+                   uint64_t now, bool cooldown) {
+        if (!mac || !ch) { invalidate(); return 6; }
+        if (!valid || channel != ch || memcmp(dst, mac, sizeof(dst)))
+            start(mac, ch);
+        if (!fresh) { resetTier(); return 6; }
+        if (cooldown) return 6;
+        const unsigned allowed = allowedTier(rssi);
+        // Demote to a previously traversed tier and discard its old ACK credit.
+        if (tier > allowed) {
+            tier = static_cast<uint8_t>(allowed);
+            acked = 0;
+            ++generation;
+        }
+        /* Constant new TX must not refresh this: only ACK reports do. */
+        if (!lastAckUS || (now > lastAckUS && now - lastAckUS > rateEvidenceAgeUS)) {
+            if (tier) resetTier();
+            else acked = 0;
+            return currentMbps();
+        }
+        if (tier < allowed && acked >= ratePromotionAcks) {
+            ++tier; acked = 0; ++generation;
+        }
+        return currentMbps();
+    }
+    bool complete(const uint8_t *mac, bool ackedFlag, uint8_t mbps, uint16_t ch,
+                  uint32_t gen, uint64_t now) {
+        if (!valid || !mac || gen != generation || ch != channel ||
+            mbps != currentMbps() || memcmp(dst, mac, sizeof(dst)))
+            return false;
+        if (!ackedFlag) { invalidate(); return true; }
+        if (acked < 0xffff) ++acked;
+        lastAckUS = now;
+        return true;
+    }
+};
