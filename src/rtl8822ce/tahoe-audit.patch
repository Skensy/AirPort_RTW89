+/* Check the DMA source before the RX decoder accesses the frame. */
+static bool rtw_pci_rx_span_valid(const u8 *data, u32 desc_len, u32 buf_len)
+{
+	const struct rtw_rx_desc *desc = (const struct rtw_rx_desc *)data;
+	u32 offset, len;
+	__le16 fc;
+
+	if (desc_len < sizeof(*desc) || desc_len > buf_len)
+		return false;
+	offset = desc_len + 8 * le32_get_bits(desc->w0, RTW_RX_DESC_W0_DRV_INFO_SIZE) +
+		 le32_get_bits(desc->w0, RTW_RX_DESC_W0_SHIFT);
+	len = le32_get_bits(desc->w0, RTW_RX_DESC_W0_PKT_LEN);
+	if (offset > buf_len || len > buf_len - offset)
+		return false;
+	if (le32_get_bits(desc->w2, RTW_RX_DESC_W2_C2H))
+		return len >= sizeof(struct rtw_c2h_cmd);
+	if (len < 10) /* smallest supported 802.11 control frame */
+		return false;
+	memcpy(&fc, data + offset, sizeof(fc));
+	return ieee80211_is_ctl(fc) || len >= 24;
+}
