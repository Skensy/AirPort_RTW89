+IOReturn AirportRTW88::scanRequestedChannel(const apple80211_channel *channels, uint32_t count,
+                                            const uint8_t *ssid, uint32_t ssidLen, uint32_t type)
+{
+    if (ssidLen > APPLE80211_MAX_SSID_LEN) return kIOReturnBadArgument;
+    setProperty("STA_SCAN_REQUEST_TYPE", (uint64_t)type, 32);
+    setProperty("STA_SCAN_REQUEST_CHANNELS", (uint64_t)count, 32);
+    if (version_major < 25 || type == APPLE80211_SCAN_TYPE_BACKGROUND ||
+        (type == APPLE80211_SCAN_TYPE_FAST && !ssidLen) || (!ssidLen && count != 1))
+        return kIOReturnUnsupported;
+    uint32_t channel = count == 1 ? channels[0].channel : 0;
+    if (count == 1 && (!channel || channel > 196)) return kIOReturnUnsupported;
+    // With multiple channels, retain the normal cache policy for an associated
+    // station. A directed fallback can still probe its current channel.
+    if (count != 1 && _ieee80211->rawState() == RTW88_STATE_CONNECTED) {
+        channel = _ieee80211->infrastructureChannel();
+        if (!channel) return kIOReturnUnsupported;
+        uint32_t i = 0;
+        while (i < count && channels[i].channel != channel) ++i;
+        if (count && i == count) return kIOReturnUnsupported;
+    }
+    _scanInProgress = true;
+    _scanCursor = 0;
+    IOReturn ret = _ieee80211->cmdScanChannel((uint16_t)channel, ssid, ssidLen,
+                                              type == APPLE80211_SCAN_TYPE_PASSIVE);
+    if (ret != kIOReturnSuccess) _scanInProgress = false;
+    setProperty("STA_REQUESTED_SCAN_CHANNEL", (uint64_t)channel, 32);
+    setProperty("STA_REQUESTED_SCAN_SSID_LENGTH", (uint64_t)ssidLen, 32);
+    setProperty("STA_REQUESTED_SCAN_STATUS", (uint64_t)(uint32_t)ret, 32);
+    return ret;
+}
