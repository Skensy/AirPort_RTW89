@@ -0,0 +1,70 @@
+"""Exercise the Tahoe scan policy with the same method the driver dispatches."""
+from pathlib import Path
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[1]
+source = (root / "src/kext/AirportRTW88.cpp").read_text()
+start = source.index("IOReturn AirportRTW88::scanRequestedChannel(")
+end = source.index("\n}\n", start) + 3
+stubs = r"""
+#include <cassert>
+#include <cstdint>
+#include <cstring>
+using IOReturn=int;
+constexpr int kIOReturnSuccess=0, kIOReturnUnsupported=1, kIOReturnBadArgument=2;
+constexpr unsigned APPLE80211_MAX_SSID_LEN=32, APPLE80211_SCAN_TYPE_FAST=3,
+  APPLE80211_SCAN_TYPE_BACKGROUND=4, APPLE80211_SCAN_TYPE_PASSIVE=2, RTW88_STATE_CONNECTED=5;
+int version_major=25;
+struct apple80211_channel { uint32_t channel; };
+struct Radio {
+    unsigned state=RTW88_STATE_CONNECTED, channel=0, length=0;
+    bool passive=false;
+    int result=0;
+    unsigned rawState() const { return state; }
+    unsigned infrastructureChannel() const { return 44; }
+    int cmdScanChannel(uint16_t ch, const uint8_t*, uint32_t n, bool p) {
+        channel=ch; length=n; passive=p; return result;
+    }
+};
+struct AirportRTW88 {
+    Radio *_ieee80211;
+    bool _scanInProgress=false; unsigned _scanCursor=7;
+    void setProperty(const char *, uint64_t, int) {}
+    IOReturn scanRequestedChannel(const apple80211_channel*,uint32_t,const uint8_t*,uint32_t,uint32_t);
+};
+"""
+cases = r"""
+int main() {
+    Radio radio; AirportRTW88 driver{&radio};
+    const uint8_t name[]={'t',0,'s'};
+    const apple80211_channel ch[]={{44},{149}};
+    auto run=[&](const apple80211_channel *c,unsigned count,unsigned len,unsigned type) {
+        return driver.scanRequestedChannel(c,count,name,len,type);
+    };
+    assert(run(ch,1,3,1)==0 && radio.channel==44 && radio.length==3 && !radio.passive);
+    assert(run(ch+1,1,0,2)==0 && radio.channel==149 && radio.passive);
+    assert(run(ch,2,3,1)==0 && radio.channel==44);
+    const apple80211_channel others[]={{6},{149}};
+    assert(run(others,2,3,1)==kIOReturnUnsupported);
+    assert(run(ch,2,0,1)==kIOReturnUnsupported);
+    assert(run(nullptr,0,3,1)==0 && radio.channel==44);
+    assert(run(ch,1,0,3)==kIOReturnUnsupported);
+    assert(run(ch,1,3,4)==kIOReturnUnsupported);
+    assert(run(ch,1,33,1)==kIOReturnBadArgument);
+    radio.state=0;
+    assert(run(nullptr,0,3,1)==0 && radio.channel==0);
+    radio.result=8;
+    assert(run(ch,1,3,1)==8 && !driver._scanInProgress);
+    version_major=22;
+    assert(run(ch,1,3,1)==kIOReturnUnsupported);
+}
+"""
+with tempfile.TemporaryDirectory() as tmp:
+    program = Path(tmp) / "scan.cpp"
+    program.write_text(stubs + source[start:end] + cases)
+    binary = Path(tmp) / "test-scan"
+    subprocess.run(["xcrun", "clang++", "-std=c++17", "-fsanitize=address,undefined",
+                    str(program), "-o", str(binary)], check=True)
+    subprocess.run([binary], check=True)
+print("PASS targeted, passive, binary SSID, idle, connected and cached scan policy")
