+    uint8_t select(const uint8_t *dst, uint16_t ch, int8_t rssi, bool fresh,
+                   uint64_t now, bool cooldown, uint32_t *generation) {
+        auto &flow = slots[rateChannelSlot(ch)];
+        const uint8_t rate = flow.select(dst, ch, rssi, fresh, now, cooldown);
+        if (generation) *generation = flow.generation;
+        return rate;
