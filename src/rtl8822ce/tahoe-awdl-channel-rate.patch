+// Reserve distinct slots for the three social channels. Other channels share
+// a slot, and must still match the exact channel before reusing evidence.
+constexpr unsigned rateChannelSlots = 4;
+inline unsigned rateChannelSlot(uint16_t ch) {
+    switch (ch) {
+        case 6: return 0;
+        case 44: return 1;
+        case 149: return 2;
+        default: return 3;
+    }
+}
