+/* An skb belongs to the ring until PCI completion. Only slot->waiting is
+ * owned here. Reap missing CCX telemetry separately from explicit no-ACK. */
+void rtw_tx_report_expire(struct rtw_dev *rtwdev, bool all)
+{
+	struct rtw_tx_report *r = &rtwdev->tx_report;
+	struct sk_buff *expired[ARRAY_SIZE(r->slots)];
+	unsigned long flags, now;
+	unsigned int i, count = 0;
+
+	spin_lock_irqsave(&r->q_lock, flags);
+	now = jiffies;
+	for (i = 0; i < ARRAY_SIZE(r->slots); ++i) {
+		struct rtw_tx_report_slot *slot = &r->slots[i];
+		if (!slot->pending || (!all && time_before(now, slot->expires)))
+			continue;
+		if (slot->waiting) {
+			expired[count++] = slot->waiting;
+			slot->waiting = NULL;
+			atomic_dec(&r->wait_depth);
+		}
+		if (slot->early_valid)
+			atomic_inc(&r->diag_early_expired);
+		slot->early_valid = false;
+		slot->pending = false;
+		atomic_inc(&r->diag_purged);
+	}
+	spin_unlock_irqrestore(&r->q_lock, flags);
+	for (i = 0; i < count; ++i)
