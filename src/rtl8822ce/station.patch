+extern "C" int rtw88_program_station_mac(struct ieee80211_hw *, struct ieee80211_vif *, const uint8_t *);
+
+IOReturn RTW88IEEE80211::setStationAddress(const uint8_t *mac)
+{
+    if (!_hw || !_vif || !_powered) return kIOReturnNotReady;
+    if (!mac || (mac[0] & 1) || !(mac[0]|mac[1]|mac[2]|mac[3]|mac[4]|mac[5]))
+        return kIOReturnBadArgument;
+    if (!memcmp(mac, _macAddr, 6)) return kIOReturnSuccess;
+    if (_state != RTW88_STATE_IDLE && _state != RTW88_STATE_SCANNING) return kIOReturnBusy;
+    if (rtw88_program_station_mac(_hw, _vif, mac)) return kIOReturnError;
+    memcpy(_macAddr, mac, sizeof(_macAddr));
+    return kIOReturnSuccess;
+}
